---
// ============================================================================
// COMPONENT: StatusBadge.astro (PHASE 2 REFACTOR)
// PURPOSE: Project status indicator badge
// ----------------------------------------------------------------------------
// CHANGES:
// - Dynamic [data-status] attribute instead of class-based variants
// - CSS uses data attributes for styling
// - More maintainable and scalable
// ============================================================================

interface Props {
  status: 'early-idea' | 'active' | 'paused' | 'completed';
}

const { status } = Astro.props;

// Status display labels
const statusLabels = {
  'early-idea': 'Early Idea',
  'active': 'Active',
  'paused': 'Paused',
  'completed': 'Completed'
};

const label = statusLabels[status];
---

<span class="status-badge" data-status={status}>
  {label}
</span>

<style>
  /* ========================================================================
     STATUS BADGE - PHASE 2 REFACTOR
     Uses data attributes for dynamic styling
     ======================================================================== */
  .status-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.75rem;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border-radius: var(--radius-sm);
    border: 1px solid;
    white-space: nowrap;
  }

  /* ========================================================================
     STATUS VARIANTS - Data attribute styling
     ======================================================================== */
  
  /* Early Idea - Blue/Purple */
  .status-badge[data-status="early-idea"] {
    background: rgba(139, 92, 246, 0.15);
    color: #c4b5fd;
    border-color: rgba(139, 92, 246, 0.3);
  }

  /* Active - Teal/Cyan */
  .status-badge[data-status="active"] {
    background: rgba(93, 225, 228, 0.15);
    color: var(--color-primary-bright);
    border-color: rgba(93, 225, 228, 0.3);
  }

  /* Paused - Amber/Yellow */
  .status-badge[data-status="paused"] {
    background: rgba(251, 191, 36, 0.15);
    color: #fde047;
    border-color: rgba(251, 191, 36, 0.3);
  }

  /* Completed - Green */
  .status-badge[data-status="completed"] {
    background: rgba(34, 197, 94, 0.15);
    color: #86efac;
    border-color: rgba(34, 197, 94, 0.3);
  }

  /* ========================================================================
     HOVER STATE (Optional)
     ======================================================================== */
  .status-badge:hover {
    opacity: 0.9;
  }
</style>