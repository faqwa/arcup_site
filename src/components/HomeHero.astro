---
// ============================================================================
// COMPONENT: HomeHero.astro (PHASE 2 REFACTOR)
// PURPOSE: Flagship hero for homepage with mobile accordion support
// ----------------------------------------------------------------------------
// CHANGES:
// - Mobile: Two-step accordion for narrative cards
// - Unified animations via .fade-in-up utility classes
// - Reduced nested blurs for performance
// - Preserved desktop panorama layout
// ============================================================================

import LinkButton from "./LinkButton.astro";
import { withBase } from "../utils/paths";
---

<section class="home-hero" aria-labelledby="main-title">
  
  <div class="panorama-grid">
    
    <!-- IDENTITY ZONE (4 cols desktop) -->
    <div class="identity-zone fade-in-up">
      <p class="eyebrow">Open Research for a Thriving Earth</p>
      
      <h1 id="main-title" class="hero-title">
        arc<sup>^</sup>
      </h1>
      
      <p class="lead">
        Building plasma technologies for <strong>ecological repair</strong> through 
        transparent, collaborative, and <em>ethical research</em>.
      </p>
    </div>

    <!-- NARRATIVE STACK (8 cols desktop) -->
    <div class="narrative-stack">
      
      <!-- Desktop: Connecting line -->
      <div class="narrative-connector" aria-hidden="true"></div>
      
      <div class="narrative-content">
        
        <!-- Card 1: Experimentation -->
        <details class="narrative-card fade-in-up delay-1" open>
          <summary class="theme-label">Experimentation</summary>
          <div class="card-body">
            <p>
              We develop and test plasma-based solutions in the open. Every experiment, 
              every result, and every method is documented and shared. Our research explores 
              how controlled plasma can support soil regeneration, water purification, 
              and atmospheric balance.
            </p>
          </div>
        </details>

        <!-- Card 2: Verification -->
        <details class="narrative-card fade-in-up delay-2" open>
          <summary class="theme-label">Verification</summary>
          <div class="card-body">
            <p>
              All findings are made freely available for independent review and replication. 
              We believe that <strong>science advances through verification</strong>, not 
              secrecy. Community feedback and peer collaboration strengthen every outcome.
            </p>
          </div>
        </details>

        <!-- Card 3: Ethics -->
        <details class="narrative-card fade-in-up delay-3" open>
          <summary class="theme-label">Ethics</summary>
          <div class="card-body">
            <p>
              Our work follows <em>clear ethical guidelines</em> that prioritize safety, 
              environmental responsibility, and inclusive participation. We're committed to 
              research that serves life—not extraction or exploitation.
            </p>
          </div>
        </details>
        
      </div>
    </div>

    <!-- CTA ZONE -->
    <div class="cta-zone fade-in-up delay-4">
      <LinkButton 
        href={withBase("/projects")} 
        variant="primary" 
        icon="arrow-right"
        aria-label="Explore active research projects"
      >
        Explore Projects
      </LinkButton>
      
      <LinkButton 
        href={withBase("/about")} 
        variant="outline" 
        icon="arrow-right"
        aria-label="Learn more about ArcUp's mission"
      >
        Learn More
      </LinkButton>
    </div>
    
  </div>
</section>

<style>
  /* ========================================================================
     HOME HERO - PHASE 2 REFACTOR
     ======================================================================== */
  .home-hero {
    position: relative;
    padding-top: clamp(4rem, 8vw, 6rem);
    padding-bottom: clamp(4rem, 8vw, 6rem);
  }

  /* Radial glow - single layer */
  .home-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at center,
      rgba(10, 147, 150, 0.05) 0%,
      transparent 70%
    );
    pointer-events: none;
    z-index: -1;
  }

  /* ========================================================================
     PANORAMA GRID
     ======================================================================== */
  .panorama-grid {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .panorama-grid {
      grid-template-columns: repeat(12, 1fr);
      gap: clamp(3rem, 5vw, 4rem);
    }
  }

  /* ========================================================================
     IDENTITY ZONE
     ======================================================================== */
  .identity-zone {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2.5vw, 1.5rem);
    text-align: center;
  }

  @media (min-width: 1024px) {
    .identity-zone {
      grid-column: span 4;
      text-align: left;
      justify-content: center;
      align-self: center;
    }
  }

  .identity-zone .hero-title {
    font-size: clamp(3.5rem, 9vw, 6rem);
    font-weight: var(--font-weight-bold);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin: 0;
  }

  .identity-zone .lead {
    max-width: 60ch;
    line-height: 1.75;
    color: var(--color-text-muted);
  }

  @media (max-width: 1023px) {
    .identity-zone .lead {
      margin: 0 auto;
    }
  }

  /* ========================================================================
     NARRATIVE STACK
     ======================================================================== */
  .narrative-stack {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 1024px) {
    .narrative-stack {
      grid-column: span 8;
    }
  }

  /* Connecting line (desktop only) */
  .narrative-connector {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(
      to bottom,
      transparent,
      rgba(10, 147, 150, 0.2) 10%,
      rgba(10, 147, 150, 0.2) 90%,
      transparent
    );
    border-radius: 2px;
  }

  @media (max-width: 1023px) {
    .narrative-connector {
      display: none;
    }
  }

  .narrative-content {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2rem);
    padding-left: clamp(0rem, 1vw, 2rem);
  }

  @media (min-width: 1024px) {
    .narrative-content {
      padding-left: 2rem;
    }
  }

  /* ========================================================================
     NARRATIVE CARDS - Accordion on mobile, static on desktop
     ======================================================================== */
  .narrative-card {
    background: rgba(15, 23, 42, 0.3);
    border: 1px solid rgba(148, 163, 184, 0.1);
    border-radius: var(--radius-md);
    transition: border-color var(--transition-base);
  }

  .narrative-card:hover {
    border-color: rgba(93, 225, 228, 0.15);
  }

  /* Summary (theme label) */
  .theme-label {
    font-size: var(--text-base);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.05em;
    color: var(--color-primary-bright);
    padding: clamp(1.25rem, 2.5vw, 1.5rem);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  /* Remove default marker */
  .theme-label::-webkit-details-marker {
    display: none;
  }

  /* Card body content */
  .card-body {
    padding: 0 clamp(1.25rem, 2.5vw, 1.5rem) clamp(1.25rem, 2.5vw, 1.5rem);
  }

  .card-body p {
    margin: 0;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  /* Desktop: Always show content (no accordion behavior) */
  @media (min-width: 768px) {
    .narrative-card {
      padding: clamp(1.25rem, 2.5vw, 1.5rem);
    }

    .theme-label {
      padding: 0;
      cursor: default;
      margin-bottom: var(--space-md);
    }

    .card-body {
      padding: 0;
    }

    /* Hide details arrow on desktop */
    .narrative-card summary {
      pointer-events: none;
    }
  }

  /* Mobile: Accordion indicator */
  @media (max-width: 767px) {
    .theme-label::after {
      content: '▼';
      float: right;
      font-size: 0.85em;
      transition: transform var(--transition-base);
    }

    .narrative-card[open] .theme-label::after {
      transform: rotate(180deg);
    }
  }

  /* ========================================================================
     CTA ZONE
     ======================================================================== */
  .cta-zone {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-lg);
    padding: clamp(1.5rem, 3vw, 2rem);
    margin-top: clamp(3rem, 6vw, 4rem);
    background: linear-gradient(
      to top,
      rgba(10, 147, 150, 0.1),
      transparent
    );
    border-radius: var(--radius-lg);
  }

  @media (min-width: 1024px) {
    .cta-zone {
      grid-column: span 12;
    }
  }

  @media (max-width: 640px) {
    .cta-zone {
      flex-direction: column;
      gap: var(--space-md);
    }
  }

  /* ========================================================================
     TEXT EMPHASIS
     ======================================================================== */
  .identity-zone strong,
  .card-body strong {
    color: var(--color-text);
    font-weight: var(--font-weight-semibold);
  }

  .identity-zone em,
  .card-body em {
    color: var(--color-primary-bright);
    font-style: normal;
  }
</style>