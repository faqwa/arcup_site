---
// ============================================================================
// COMPONENT: Card.astro (PHASE 2 REFACTOR)
// PURPOSE: Generic card component with surface panel styling
// ----------------------------------------------------------------------------
// CHANGES:
// - Merged padding variants: compact | default (was normal/compact/spacious)
// - Added .card--active state
// - Drop blur on mobile for performance
// ============================================================================

interface Props {
  variant?: 'default' | 'surface' | 'outline' | 'ghost';
  hover?: boolean;
  padding?: 'compact' | 'default';
  active?: boolean;
  as?: 'div' | 'article' | 'section';
  class?: string;
}

const {
  variant = 'surface',
  hover = true,
  padding = 'default',
  active = false,
  as: Element = 'div',
  class: className = '',
  ...attrs
} = Astro.props;


const classes = [
  'card',
  `card--${variant}`,
  `card--${padding}`,
  hover && 'card--hover',
  active && 'card--active',
  className
].filter(Boolean).join(' ');
---

<Element class={classes} {...attrs}>
  <slot />
</Element>

<style>
  /* ========================================================================
     CARD COMPONENT - PHASE 2 REFACTOR
     ======================================================================== */
  .card {
    border-radius: var(--radius-lg);
    transition: all var(--transition-base);
    display: flex;
    flex-direction: column;
  }

  /* ========================================================================
     VARIANT STYLES
     ======================================================================== */
  .card--surface {
    background: linear-gradient(
      to bottom right,
      rgba(15,23,42,0.75),
      rgba(10,147,150,0.05)
    );
    border: 1px solid rgba(93,225,228,0.1);
    box-shadow: var(--shadow-soft);
  }


  /* Desktop: Add blur */
  @media (min-width: 769px) {
    .card--surface {
      backdrop-filter: blur(10px);
    }
  }

  /* Mobile: Drop blur for performance */
  @media (max-width: 768px) {
    .card--surface {
      backdrop-filter: none;
      background: rgba(15, 23, 42, 0.7);
    }
  }

  .card--outline {
    background: transparent;
    border: 1px solid var(--color-border);
  }

  .card--default {
    background: var(--color-bg-accent);
    border: 1px solid var(--color-border);
  }

  .card--ghost {
    background: transparent;
    border: none;
  }

  /* ========================================================================
     PADDING VARIANTS - Simplified to 2 options
     ======================================================================== */
  .card--compact { padding: var(--space-lg); }
  .card--default { padding: var(--space-xl); }


  /* ========================================================================
     ACTIVE STATE - New in Phase 2
     ======================================================================== */
  .card--active {
    border-color: rgba(93, 225, 228, 0.5);
    background: rgba(15, 23, 42, 0.7);
    box-shadow: 
      var(--shadow-soft),
      0 0 20px rgba(93, 225, 228, 0.15);
  }

  /* ========================================================================
     HOVER EFFECTS
     ======================================================================== */
  .card--hover:hover {
    border-color: rgba(93,225,228,0.35);
    transform: translateY(-2px);
    box-shadow:
      0 0 30px rgba(93,225,228,0.08),
      var(--shadow-soft);
  }


  .card--hover:focus-within {
    border-color: rgba(93, 225, 228, 0.5);
    box-shadow: var(--shadow-strong);
  }

  /* Disable hover on mobile for performance */
  @media (max-width: 768px) {
    .card--hover:hover {
      transform: none;
    }
  }
.card[href] {
  cursor: pointer;
  text-decoration: none;
  color: inherit;
  position: relative;
}

.card[href]:hover {
  border-color: rgba(93,225,228,0.35);
  box-shadow: 0 0 30px rgba(93,225,228,0.08), var(--shadow-soft);
  transform: translateY(-2px);
}

.card[href]::after {
  content: "→";
  position: absolute;
  right: var(--space-lg);
  top: 50%;
  transform: translateY(-50%) translateX(-4px);
  opacity: 0;
  transition: all var(--transition-base);
  color: var(--color-primary-bright);
}

.card[href]:hover::after {
  opacity: 1;
  transform: translateY(-50%) translateX(2px);
}

  /* ========================================================================
     ACCESSIBILITY
     ======================================================================== */
  @media (prefers-reduced-motion: reduce) {
    .card,
    .card--hover:hover {
      transform: none;
      transition: none;
    }
  }
</style>