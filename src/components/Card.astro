---
// ============================================================================
// COMPONENT: Card.astro (PHASE 2 REFACTOR)
// PURPOSE: Generic card component with surface panel styling
// ----------------------------------------------------------------------------
// CHANGES:
// - Merged padding variants: compact | default (was normal/compact/spacious)
// - Added .card--active state
// - Drop blur on mobile for performance
// ============================================================================

interface Props {
  variant?: 'default' | 'surface' | 'outline' | 'ghost';
  hover?: boolean;
  padding?: 'compact' | 'default';
  active?: boolean;
  as?: 'div' | 'article' | 'section';
  class?: string;
}

const { 
  variant = 'surface',
  hover = true,
  padding = 'default',
  active = false,
  as: Element = 'div',
  class: className = ''
} = Astro.props;

const classes = [
  'card',
  `card--${variant}`,
  `card--${padding}`,
  hover && 'card--hover',
  active && 'card--active',
  className
].filter(Boolean).join(' ');
---

<Element class={classes}>
  <slot />
</Element>

<style>
  /* ========================================================================
     CARD COMPONENT - PHASE 2 REFACTOR
     ======================================================================== */
  .card {
    border-radius: var(--radius-lg);
    transition: all var(--transition-base);
    display: flex;
    flex-direction: column;
  }

  /* ========================================================================
     VARIANT STYLES
     ======================================================================== */
  .card--surface {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-soft);
  }

  /* Desktop: Add blur */
  @media (min-width: 769px) {
    .card--surface {
      backdrop-filter: blur(10px);
    }
  }

  /* Mobile: Drop blur for performance */
  @media (max-width: 768px) {
    .card--surface {
      backdrop-filter: none;
      background: rgba(15, 23, 42, 0.7);
    }
  }

  .card--outline {
    background: transparent;
    border: 1px solid var(--color-border);
  }

  .card--default {
    background: var(--color-bg-accent);
    border: 1px solid var(--color-border);
  }

  .card--ghost {
    background: transparent;
    border: none;
  }

  /* ========================================================================
     PADDING VARIANTS - Simplified to 2 options
     ======================================================================== */
  .card--compact {
    padding: clamp(1rem, 3vw, 1.5rem);
  }

  .card--default {
    padding: clamp(1.75rem, 4vw, 2.25rem);
  }

  /* ========================================================================
     ACTIVE STATE - New in Phase 2
     ======================================================================== */
  .card--active {
    border-color: rgba(93, 225, 228, 0.5);
    background: rgba(15, 23, 42, 0.7);
    box-shadow: 
      var(--shadow-soft),
      0 0 20px rgba(93, 225, 228, 0.15);
  }

  /* ========================================================================
     HOVER EFFECTS
     ======================================================================== */
  .card--hover:hover {
    border-color: rgba(93, 225, 228, 0.35);
    transform: translateY(-2px);
    box-shadow: var(--shadow-strong);
  }

  .card--hover:focus-within {
    border-color: rgba(93, 225, 228, 0.5);
    box-shadow: var(--shadow-strong);
  }

  /* Disable hover on mobile for performance */
  @media (max-width: 768px) {
    .card--hover:hover {
      transform: none;
    }
  }

  /* ========================================================================
     ACCESSIBILITY
     ======================================================================== */
  @media (prefers-reduced-motion: reduce) {
    .card,
    .card--hover:hover {
      transform: none;
      transition: none;
    }
  }
</style>