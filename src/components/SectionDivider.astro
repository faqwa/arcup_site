---
// ============================================================================
// COMPONENT: SectionDivider.astro (PHASE 2 REFACTOR)
// PURPOSE: Visual separator between page sections
// ----------------------------------------------------------------------------
// CHANGES:
// - Added variant prop: subtle | strong
// - Replaced inline styles with proper variants
// - More semantic and maintainable
// ============================================================================

interface Props {
  variant?: 'subtle' | 'strong';
  class?: string;
}

const { 
  variant = 'subtle',
  class: className = ''
} = Astro.props;

const classes = [
  'section-divider',
  `divider-${variant}`,
  className
].filter(Boolean).join(' ');
---

<hr class={classes} aria-hidden="true" />

<style>
  /* ========================================================================
     SECTION DIVIDER - PHASE 2 REFACTOR
     Proper variant system
     ======================================================================== */
  .section-divider {
    width: 100%;
    height: 1px;
    border: none;
    margin: var(--section-gap) 0;
  }

  /* ========================================================================
     VARIANTS
     ======================================================================== */
  
  /* Subtle - Soft gradient fade */
  .divider-subtle {
    background: linear-gradient(
      to right,
      transparent,
      var(--color-border) 20%,
      var(--color-border) 80%,
      transparent
    );
    opacity: 0.6;
  }

  /* Strong - Accent gradient with cyan */
  .divider-strong {
    background: linear-gradient(
      to right,
      transparent,
      rgba(93, 225, 228, 0.3) 20%,
      rgba(93, 225, 228, 0.3) 80%,
      transparent
    );
  }

  /* ========================================================================
     RESPONSIVE
     ======================================================================== */
  @media (max-width: 640px) {
    .section-divider {
      margin: clamp(2rem, 5vw, 3rem) 0;
    }
  }
</style>