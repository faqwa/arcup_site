---
// ============================================================================
// COMPONENT: Hero.astro (PHASE 2 REFACTOR)
// PURPOSE: Unified section hero for non-homepage pages
// ----------------------------------------------------------------------------
// CHANGES:
// - Added subtle-bg prop variant for tinted background
// - All clamps now use global tokens
// - Preserved accessibility and semantic structure
// ============================================================================

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'center' | 'left';
  id?: string;
  subtleBg?: boolean;
}

const { 
  eyebrow,
  title,
  description,
  align = 'center',
  id = 'page-title',
  subtleBg = false
} = Astro.props;

const alignmentClass = align === 'center' ? 'text-center' : 'text-left';
const bgClass = subtleBg ? 'hero--subtle-bg' : '';
---

<header 
  class={`page-hero ${alignmentClass} ${bgClass}`}
  aria-labelledby={id}
>
  <div class="hero-container">
    <div class="hero-content">
      
      {eyebrow && (
        <p class="eyebrow">{eyebrow}</p>
      )}
      
      <h1 id={id} class="hero-title">
        {title}
      </h1>
      
      {description && (
        <p class="lead" set:html={description} />
      )}

      <slot />
      
    </div>
  </div>
</header>

<style>
  /* ========================================================================
     HERO COMPONENT - PHASE 2 REFACTOR
     All values use global tokens
     ======================================================================== */
  .page-hero {
    padding-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  @media (min-width: 1024px) {
    .page-hero {
      padding-top: clamp(5rem, 8vw, 8rem);
      padding-bottom: clamp(5rem, 8vw, 8rem);
    }
  }

  /* Subtle background variant */
  .hero--subtle-bg {
    background: linear-gradient(
      to bottom,
      rgba(10, 147, 150, 0.03),
      transparent 60%
    );
    border-radius: var(--radius-lg);
  }

  .hero-container {
    max-width: var(--shell-width);
    margin-left: auto;
    margin-right: auto;
    padding-left: var(--shell-padding);
    padding-right: var(--shell-padding);
  }

  .hero-content {
    max-width: 56rem;
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2.5vw, 1.5rem);
  }

  .text-center .hero-content {
    margin-left: auto;
    margin-right: auto;
  }

  .text-left .hero-content {
    margin-left: 0;
    margin-right: auto;
  }

  .page-hero .eyebrow {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary-bright);
  }

  .page-hero .hero-title {
    font-size: clamp(2.25rem, 5vw, 3rem);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-tight);
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin: 0;
  }

  @media (min-width: 768px) {
    .page-hero .hero-title {
      font-size: clamp(2.75rem, 6vw, 3.75rem);
    }
  }

  .page-hero .lead {
    font-size: clamp(1.1rem, 2.2vw, 1.25rem);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    max-width: 65ch;
  }

  .text-center .lead {
    margin-left: auto;
    margin-right: auto;
  }

  .page-hero strong {
    color: var(--color-text);
    font-weight: var(--font-weight-semibold);
  }

  .page-hero em {
    color: var(--color-primary-bright);
    font-style: normal;
  }
</style>