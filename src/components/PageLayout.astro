---
// ============================================================================
// COMPONENT: PageLayout.astro
// PURPOSE: Reusable two-column layout with sticky sidebar navigation
// ----------------------------------------------------------------------------
// USAGE: Content pages that need internal navigation (about, how, etc.)
// FEATURES:
// - Sticky sidebar navigation on desktop
// - Collapsible navigation on mobile
// - Optional nav links via props
// - Uses only global CSS tokens
// ============================================================================

interface NavLink {
  href: string;
  label: string;
}

interface Props {
  navLinks?: NavLink[];
  showNav?: boolean;
}

const { 
  navLinks = [],
  showNav = true
} = Astro.props;
---

<div class="page-layout">
  
  {showNav && navLinks.length > 0 && (
    <!-- Sidebar Navigation -->
    <aside class="page-sidebar">
      <nav class="sidebar-nav-inner" aria-label="Page sections">
        {navLinks.map(link => (
          <a href={link.href} class="sidebar-link">{link.label}</a>
        ))}
      </nav>
      
      <!-- Mobile Collapsible Nav -->
      <details class="sidebar-nav-mobile">
        <summary>Navigate this page</summary>
        <nav>
          {navLinks.map(link => (
            <a href={link.href}>{link.label}</a>
          ))}
        </nav>
      </details>
    </aside>
  )}

  <!-- Main Content Area -->
  <main class={showNav ? 'page-content' : 'page-content-full'}>
    <slot />
  </main>
  
</div>

<style>
  /* Page Layout Container */
  .page-layout {
    max-width: var(--container-max, 1200px);
    margin: 0 auto;
    padding: 0 var(--space-page, 2rem);
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  @media (min-width: 1024px) {
    .page-layout {
      grid-template-columns: 260px 1fr;
      gap: var(--space-2xl, 3rem);
      padding-top: var(--space-2xl, 3rem);
    }
  }

  /* Sidebar Navigation */
  .page-sidebar {
    position: relative;
  }

  .sidebar-nav-inner {
    display: none;
  }

  @media (min-width: 1024px) {
    .sidebar-nav-inner {
      display: flex;
      flex-direction: column;
      gap: var(--space-sm, 0.75rem);
      position: sticky;
      top: 5rem;
      padding: var(--space-lg, 1.5rem);
      background: var(--color-surface, rgba(6, 12, 20, 0.35));
      border: 1px solid var(--color-border, rgba(148, 163, 184, 0.18));
      border-radius: var(--radius-md, 0.5rem);
      backdrop-filter: blur(8px);
    }
  }

  .sidebar-link {
    display: block;
    padding: var(--space-xs, 0.5rem) var(--space-sm, 0.75rem);
    color: var(--color-text-muted, #9aa7bd);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    border-radius: var(--radius-sm, 0.25rem);
    transition: all 0.2s ease;
    border-left: 2px solid transparent;
  }

  .sidebar-link:hover {
    color: var(--color-text, #f1f5f9);
    background: rgba(148, 163, 184, 0.08);
    border-left-color: var(--color-primary-bright, #0ebfc2);
  }

  /* Mobile Navigation */
  .sidebar-nav-mobile {
    display: block;
    margin: var(--space-xl, 2rem) 0;
    padding: var(--space-md, 1rem);
    background: var(--color-surface, rgba(6, 12, 20, 0.35));
    border: 1px solid var(--color-border, rgba(148, 163, 184, 0.18));
    border-radius: var(--radius-md, 0.5rem);
  }

  @media (min-width: 1024px) {
    .sidebar-nav-mobile {
      display: none;
    }
  }

  .sidebar-nav-mobile summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--color-text, #f1f5f9);
    list-style: none;
  }

  .sidebar-nav-mobile summary::-webkit-details-marker {
    display: none;
  }

  .sidebar-nav-mobile nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs, 0.5rem);
    margin-top: var(--space-md, 1rem);
  }

  .sidebar-nav-mobile a {
    color: var(--color-text-muted, #9aa7bd);
    text-decoration: none;
    padding: var(--space-xs, 0.5rem);
    border-radius: var(--radius-sm, 0.25rem);
    transition: all 0.2s ease;
  }

  .sidebar-nav-mobile a:hover {
    color: var(--color-text, #f1f5f9);
    background: rgba(148, 163, 184, 0.08);
  }

  /* Main Content */
  .page-content,
  .page-content-full {
    min-width: 0;
  }

  /* Full width when no sidebar */
  @media (min-width: 1024px) {
    .page-layout:has(.page-content-full) {
      grid-template-columns: 1fr;
    }
  }

  /* Content Sections */
  .page-content :global(.content-section) {
    padding-block: var(--space-section, 5rem);
  }

  .page-content :global(.content-section:first-child) {
    padding-top: var(--space-2xl, 3rem);
  }

  @media (max-width: 768px) {
    .page-content :global(.content-section) {
      padding-block: var(--space-xl, 3rem);
    }
  }

  /* Scroll Padding for Anchor Links */
  :global(section[id]) {
    scroll-margin-top: 5rem;
  }
</style>