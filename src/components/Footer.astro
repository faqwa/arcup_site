---
// ============================================================================
// COMPONENT: Footer.astro (PHASE 2 REFACTOR)
// PURPOSE: Site-wide footer with navigation and legal info
// ----------------------------------------------------------------------------
// CHANGES:
// - Merged license + copyright into single line
// - Added gradient divider above footer
// - Streamlined layout
// ============================================================================

import { EXTERNAL_LINKS } from '../config/constants';
import { withBase } from '../utils/paths';

const currentYear = new Date().getFullYear();

const footerLinks = [
  { label: 'About', href: withBase('/about') },
  { label: 'How We Work', href: withBase('/how') },
  { label: 'Projects', href: withBase('/projects') },
  { label: 'Join', href: withBase('/join') },
];

const socialLinks = [
  { 
    name: 'YouTube', 
    url: EXTERNAL_LINKS.youtube,
    icon: 'youtube' 
  },
  { 
    name: 'Discord', 
    url: EXTERNAL_LINKS.discord,
    icon: 'discord' 
  },
];
---

<!-- Gradient Divider -->
<div class="footer-divider" aria-hidden="true"></div>

<footer class="site-footer" role="contentinfo">
  <div class="footer-container">
    
    <!-- Brand Section -->
    <div class="footer-brand">
      <a href={withBase('/')} class="footer-logo">
        arc<sup>^</sup>
      </a>
      <p class="footer-tagline">
        Open experimental plasma research for ecological repair
      </p>
    </div>

    <!-- Navigation -->
    <nav class="footer-nav" aria-label="Footer navigation">
      <ul class="footer-links">
        {footerLinks.map(link => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Social Links -->
    <div class="footer-social">
      <p class="footer-social-label">Connect</p>
      <div class="social-links">
        {socialLinks.map(social => (
          <a
            href={social.url}
            class="social-link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Visit ArcUp on ${social.name}`}
          >
            {social.icon === 'youtube' && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" role="img" aria-hidden="true">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" fill="currentColor"/>
              </svg>
            )}
            {social.icon === 'discord' && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" role="img" aria-hidden="true">
                <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z" fill="currentColor"/>
              </svg>
            )}
          </a>
        ))}
      </div>
    </div>

    <!-- Legal Info - Merged License + Copyright -->
    <div class="footer-legal">
      <p>
        © {currentYear} ArcUp. Licensed under <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer">CC BY-SA 4.0</a>.
      </p>
    </div>

  </div>
</footer>

<style>
  /* ========================================================================
     FOOTER DIVIDER - Gradient separator
     ======================================================================== */
  .footer-divider {
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      rgba(93, 225, 228, 0.3) 20%,
      rgba(93, 225, 228, 0.3) 80%,
      transparent
    );
    margin: var(--space-3xl) 0 var(--space-2xl);
  }

  /* ========================================================================
     SITE FOOTER
     ======================================================================== */
  .site-footer {
    padding: var(--space-2xl) 0;
    background: linear-gradient(
      to top,
      rgba(10, 147, 150, 0.05),
      transparent 60%
    );
  }

  .footer-container {
    max-width: var(--shell-width);
    margin: 0 auto;
    padding: 0 var(--shell-padding);
    display: grid;
    gap: var(--space-2xl);
  }

  @media (min-width: 768px) {
    .footer-container {
      grid-template-columns: 2fr 1fr 1fr;
      align-items: start;
    }
  }

  /* ========================================================================
     FOOTER BRAND
     ======================================================================== */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer-logo {
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.08em;
    text-decoration: none;
    color: var(--color-text);
    text-transform: lowercase;
    transition: color var(--transition-base);
  }

  .footer-logo:hover {
    color: var(--color-primary-bright);
  }

  .footer-logo sup {
    font-size: 0.6em;
    color: var(--color-primary-bright);
  }

  .footer-tagline {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
    max-width: 32ch;
  }

  /* ========================================================================
     FOOTER NAVIGATION
     ======================================================================== */
  .footer-nav {
    display: flex;
    flex-direction: column;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer-links a {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .footer-links a:hover {
    color: var(--color-primary-bright);
  }

  /* ========================================================================
     FOOTER SOCIAL
     ======================================================================== */
  .footer-social {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer-social-label {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text);
    margin: 0;
  }

  .social-links {
    display: flex;
    gap: var(--space-sm);
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--color-text-muted);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    transition: all var(--transition-base);
  }

  .social-link:hover {
    color: var(--color-primary-bright);
    border-color: var(--color-primary-bright);
    background: rgba(93, 225, 228, 0.08);
  }

  /* ========================================================================
     FOOTER LEGAL - Merged license and copyright
     ======================================================================== */
  .footer-legal {
    grid-column: 1 / -1;
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  .footer-legal p {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin: 0;
    text-align: center;
  }

  .footer-legal a {
    color: var(--color-primary-bright);
    text-decoration: underline;
    text-decoration-color: rgba(93, 225, 228, 0.3);
    transition: text-decoration-color var(--transition-base);
  }

  .footer-legal a:hover {
    text-decoration-color: var(--color-primary-bright);
  }

  /* ========================================================================
     MOBILE RESPONSIVENESS
     ======================================================================== */
  @media (max-width: 767px) {
    .footer-container {
      text-align: center;
    }

    .footer-brand {
      align-items: center;
    }

    .footer-tagline {
      margin: 0 auto;
    }

    .footer-links {
      align-items: center;
    }

    .footer-social {
      align-items: center;
    }

    .social-links {
      justify-content: center;
    }
  }
</style>