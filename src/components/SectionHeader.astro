---
// ============================================================================
// COMPONENT: SectionHeader.astro (PHASE 2 REFACTOR)
// PURPOSE: Consistent section heading component
// ----------------------------------------------------------------------------
// CHANGES:
// - Default align changed: center → left
// - Preserved all functionality
// ============================================================================

interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
  align?: 'left' | 'center';
  headingLevel?: 'h2' | 'h3' | 'h4';
}

const { 
  title, 
  subtitle, 
  eyebrow,
  align = 'left',  // Changed default from 'center' to 'left'
  headingLevel = 'h2'
} = Astro.props;

const HeadingTag = headingLevel;
---

<header class={`section-header section-header--${align}`}>
  {eyebrow && (
    <p class="section-header__eyebrow eyebrow">{eyebrow}</p>
  )}
  
  <HeadingTag class="section-header__title">
    {title}
  </HeadingTag>
  
  {subtitle && (
    <p class="section-header__subtitle lead">
      {subtitle}
    </p>
  )}
</header>

<style>
  /* ========================================================================
     SECTION HEADER - PHASE 2 REFACTOR
     Default alignment: left (was center)
     ======================================================================== */
  .section-header {
    display: grid;
    gap: clamp(0.75rem, 2vw, 1rem);
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .section-header--center {
    text-align: center;
    justify-items: center;
  }

  .section-header--left {
    text-align: left;
    justify-items: start;
  }

  .section-header__eyebrow {
    margin: 0;
  }

  .section-header__title {
    margin: 0;
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-tight);
    color: var(--color-text);
  }

  .section-header__subtitle {
    margin: 0;
    max-width: 72ch;
  }

  .section-header--center .section-header__subtitle {
    margin-inline: auto;
  }

  /* ========================================================================
     MOBILE RESPONSIVENESS
     ======================================================================== */
  @media (max-width: 640px) {
    .section-header {
      gap: 0.65rem;
    }

    .section-header__title {
      font-size: var(--text-xl);
    }
  }
</style>