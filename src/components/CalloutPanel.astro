---
// ============================================================================
// COMPONENT: CalloutPanel.astro (PHASE 2 REFACTOR)
// PURPOSE: Highlighted panel for important information
// ----------------------------------------------------------------------------
// CHANGES:
// - Flattened gradients → solid tints for clarity
// - Added icon-size-sm prop for compact icons
// - Simplified backgrounds
// ============================================================================

interface Props {
  variant?: 'info' | 'warning' | 'success' | 'neutral';
  icon?: string;
  title?: string;
  iconSize?: 'small' | 'normal';
  class?: string;
}

const { 
  variant = 'info',
  icon,
  title,
  iconSize = 'normal',
  class: className = ''
} = Astro.props;

const classes = [
  'callout-panel',
  `callout-panel--${variant}`,
  className
].filter(Boolean).join(' ');

const iconClass = iconSize === 'small' ? 'callout-panel__icon--sm' : '';
---

<aside class={classes} role="complementary">
  {(icon || title) && (
    <div class="callout-panel__header">
      {icon && (
        <span class={`callout-panel__icon ${iconClass}`} aria-hidden="true">{icon}</span>
      )}
      {title && (
        <h3 class="callout-panel__title">{title}</h3>
      )}
    </div>
  )}
  
  <div class="callout-panel__content">
    <slot />
  </div>
</aside>

<style>
  /* ========================================================================
     CALLOUT PANEL - PHASE 2 REFACTOR
     Solid tints instead of gradients
     ======================================================================== */
  .callout-panel {
    padding: clamp(1.5rem, 4vw, 2rem);
    border-radius: var(--radius-lg);
    border: 1px solid;
  }

  .callout-panel__header {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .callout-panel__icon {
    font-size: 1.5rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .callout-panel__icon--sm {
    font-size: 1.25rem;
  }

  .callout-panel__title {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-tight);
  }

  .callout-panel__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .callout-panel__content > :first-child {
    margin-top: 0;
  }

  .callout-panel__content > :last-child {
    margin-bottom: 0;
  }

  .callout-panel__content p {
    margin: 0;
    line-height: var(--leading-relaxed);
  }

  /* ========================================================================
     VARIANT STYLES - Solid tints
     ======================================================================== */
  
  /* Info - Cyan/Teal */
  .callout-panel--info {
    background: rgba(93, 225, 228, 0.08);
    border-color: rgba(93, 225, 228, 0.3);
  }

  .callout-panel--info .callout-panel__title,
  .callout-panel--info .callout-panel__icon {
    color: var(--color-primary-bright);
  }

  /* Warning - Amber */
  .callout-panel--warning {
    background: rgba(251, 191, 36, 0.08);
    border-color: rgba(251, 191, 36, 0.3);
  }

  .callout-panel--warning .callout-panel__title,
  .callout-panel--warning .callout-panel__icon {
    color: #fde047;
  }

  /* Success - Green */
  .callout-panel--success {
    background: rgba(34, 197, 94, 0.08);
    border-color: rgba(34, 197, 94, 0.3);
  }

  .callout-panel--success .callout-panel__title,
  .callout-panel--success .callout-panel__icon {
    color: #86efac;
  }

  /* Neutral - Default surface */
  .callout-panel--neutral {
    background: var(--color-surface);
    border-color: var(--color-border);
  }

  .callout-panel--neutral .callout-panel__title {
    color: var(--color-text);
  }

  .callout-panel--neutral .callout-panel__icon {
    color: var(--color-text-muted);
  }

  /* ========================================================================
     MOBILE RESPONSIVENESS
     ======================================================================== */
  @media (max-width: 640px) {
    .callout-panel {
      padding: var(--space-lg);
    }

    .callout-panel__icon {
      font-size: 1.25rem;
    }

    .callout-panel__icon--sm {
      font-size: 1rem;
    }
  }
</style>