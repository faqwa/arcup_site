---
// ============================================================================
// COMPONENT: SiteHeader.astro (SIMPLIFIED)
// PURPOSE: Global navigation header
// ----------------------------------------------------------------------------
// CHANGES:
// - Only dynamic Projects dropdown (from CMS)
// - All other dropdowns defined in constants.ts
// - No descriptions shown in dropdowns
// - Clean and maintainable
// ============================================================================

import { getCollection } from 'astro:content';
import { withBase } from '../utils/paths';
import { NAV_ITEMS, EXTERNAL_LINKS } from '../config/constants';

interface Props {
  active?: string;
}

const { active = "home" } = Astro.props;

// TypeScript interfaces
interface DropdownItem {
  key: string;
  label: string;
  href: string;
}

interface NavItem {
  key: string;
  label: string;
  href: string;
  dropdown?: DropdownItem[];
}

const currentPath = Astro.url.pathname.replace(import.meta.env.BASE_URL || '', '') || '/';

// Fetch projects for dynamic dropdown
const allProjects = await getCollection('projects');

// Build navigation - only add dynamic dropdown for projects
const navigationItems: NavItem[] = NAV_ITEMS.map((item) => {
  // Projects: Build dropdown dynamically from CMS
  if (item.key === 'projects') {
    return {
      ...item,
      dropdown: allProjects.map((project) => ({
        key: `project-${project.slug}`,
        label: project.data.title,
        href: `/projects/${project.slug}`
      }))
    };
  }
  
  // All other items: Use dropdown from constants.ts as-is
  return {
    key: item.key,
    label: item.label,
    href: item.href,
    dropdown: item.dropdown as DropdownItem[] | undefined
  };
});

// Social links
const socialLinks = [
  {
    name: "YouTube",
    url: EXTERNAL_LINKS.youtube,
    icon: "youtube",
    label: "Visit Arc^ on YouTube"
  },
  {
    name: "Discord",
    url: EXTERNAL_LINKS.discord,
    icon: "discord",
    label: "Join Arc^ Discord community"
  }
];

// Check if nav item is active
function isItemActive(item: NavItem): boolean {
  if (item.key === active) return true;
  if (item.dropdown) {
    return item.dropdown.some((subItem: DropdownItem) => currentPath === subItem.href);
  }
  return false;
}
---

<header class="site-header" role="banner">
  <div class="site-brand">
    <a href={withBase("/")} class="site-brand__link" aria-label="arc^ home">
      arc<sup>^</sup> <span class="brand-by">by</span> ali
    </a>
  </div>
  
  <nav class="site-nav" aria-label="Primary navigation">
    <ul class="nav-list">
      {navigationItems.map((item) => (
        <li class={item.dropdown ? "nav-item has-dropdown" : "nav-item"}>
          <a
            href={withBase(item.href)}
            class={isItemActive(item) ? "nav-link is-active" : "nav-link"}
            aria-current={isItemActive(item) ? "page" : undefined}
            aria-haspopup={item.dropdown ? "true" : undefined}
            aria-expanded={item.dropdown ? "false" : undefined}
          >
            {item.label}
          </a>
          
          {item.dropdown && item.dropdown.length > 0 && (
            <ul class="nav-dropdown" role="menu">
              {item.dropdown.map((subItem: DropdownItem) => (
                <li role="none">
                  <a
                    href={withBase(subItem.href)}
                    class={currentPath === subItem.href ? "nav-dropdown-link is-active" : "nav-dropdown-link"}
                    role="menuitem"
                  >
                    {subItem.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </nav>

  <div class="site-social" aria-label="Social media links">
    {socialLinks.map((social) => (
      <a
        href={social.url}
        class="social-link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={social.label}
        title={social.name}
      >
        {social.icon === "youtube" && (
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" role="img" aria-hidden="true">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" fill="currentColor"/>
          </svg>
        )}
        {social.icon === "discord" && (
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" role="img" aria-hidden="true">
            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z" fill="currentColor"/>
          </svg>
        )}
      </a>
    ))}
  </div>
</header>

<style>
  /* ========================================================================
     SITE HEADER
     ======================================================================== */
  .site-header {
    width: var(--shell-width);
    margin: clamp(1.5rem, 4vw, 2.5rem) auto 0;
    padding: var(--space-md) var(--shell-padding);
    border-radius: var(--radius-lg);
    backdrop-filter: blur(var(--blur-sm));
    background: rgba(6, 12, 22, 0.58);
    border: 1px solid var(--color-border-accent);
    box-shadow: var(--shadow-soft);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
  }

  /* ========================================================================
     SITE BRAND
     ======================================================================== */
  .site-brand {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .site-brand__link {
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.08em;
    text-decoration: none;
    color: var(--color-text);
    text-transform: lowercase;
    transition: color var(--transition-base);
  }

  .site-brand__link:hover {
    color: var(--color-primary-bright);
  }

  .site-brand__link sup {
    font-size: 0.6em;
    color: var(--color-primary-bright);
  }

  .brand-by {
    font-size: 0.65em;
    font-weight: var(--font-weight-regular);
    color: var(--color-text-muted);
    margin: 0 0.25em;
  }

  /* ========================================================================
     NAVIGATION
     ======================================================================== */
  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .nav-list {
    display: flex;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: var(--space-sm);
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    display: block;
    padding: var(--space-sm) var(--space-md);
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    border-radius: var(--radius-sm);
    transition: all var(--transition-base);
    cursor: pointer;
  }

  .nav-link:hover {
    color: var(--color-text);
    background: rgba(93, 225, 228, 0.08);
  }

  .nav-link.is-active {
    color: var(--color-primary-bright);
    background: rgba(93, 225, 228, 0.12);
  }

  /* ========================================================================
     DROPDOWN MENU - Simple, no descriptions
     ======================================================================== */
  .nav-dropdown {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    min-width: 200px;
    background: rgba(6, 12, 22, 0.95);
    backdrop-filter: blur(var(--blur-md));
    border: 1px solid var(--color-border-accent);
    border-radius: var(--radius-md);
    padding: var(--space-xs);
    list-style: none;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: all var(--transition-base);
    box-shadow: var(--shadow-lg);
    z-index: 100;
  }

  /* Show dropdown on click/focus */
  .has-dropdown:focus-within .nav-dropdown,
  .has-dropdown .nav-link:focus + .nav-dropdown,
  .has-dropdown .nav-link:active + .nav-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  /* Also show on hover for desktop */
  @media (min-width: 768px) {
    .has-dropdown:hover .nav-dropdown {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
  }

  /* Dropdown links - simple single line */
  .nav-dropdown-link {
    display: block;
    padding: var(--space-sm) var(--space-md);
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: var(--text-sm);
    border-radius: var(--radius-sm);
    transition: all var(--transition-base);
  }

  .nav-dropdown-link:hover {
    background: rgba(93, 225, 228, 0.08);
    color: var(--color-text);
  }

  .nav-dropdown-link.is-active {
    background: rgba(93, 225, 228, 0.12);
    color: var(--color-primary-bright);
  }

  /* ========================================================================
     SOCIAL LINKS
     ======================================================================== */
  .site-social {
    display: flex;
    gap: var(--space-sm);
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--color-text-muted);
    border-radius: var(--radius-sm);
    transition: all var(--transition-base);
  }

  .social-link:hover {
    color: var(--color-primary-bright);
    background: rgba(93, 225, 228, 0.08);
  }

  /* ========================================================================
     MOBILE RESPONSIVENESS
     ======================================================================== */
  @media (max-width: 768px) {
    .site-header {
      flex-direction: column;
      gap: var(--space-md);
    }

    .nav-list {
      flex-direction: column;
      width: 100%;
    }

    .nav-item {
      width: 100%;
    }

    .nav-link {
      width: 100%;
    }

    .nav-dropdown {
      position: static;
      transform: none;
      margin-top: var(--space-xs);
    }

    .site-social {
      justify-content: center;
    }
  }
</style>

<script>
  // Click-to-toggle for mobile
  document.querySelectorAll('.has-dropdown .nav-link').forEach(link => {
    link.addEventListener('click', (e) => {
      const isExpanded = link.getAttribute('aria-expanded') === 'true';
      
      // Close other dropdowns
      document.querySelectorAll('.has-dropdown .nav-link').forEach(otherLink => {
        otherLink.setAttribute('aria-expanded', 'false');
      });
      
      // Toggle current
      link.setAttribute('aria-expanded', (!isExpanded).toString());
      
      // On mobile, prevent navigation to allow dropdown use
      if (window.innerWidth < 768) {
        e.preventDefault();
      }
    });
  });

  // Close dropdown when clicking outside
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest('.has-dropdown')) {
      document.querySelectorAll('.has-dropdown .nav-link').forEach(link => {
        link.setAttribute('aria-expanded', 'false');
      });
    }
  });
</script>