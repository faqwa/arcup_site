---
// ============================================================================
// COMPONENT: LinkButton.astro (PHASE 2 REFACTOR)
// PURPOSE: CTA button component for links
// ----------------------------------------------------------------------------
// CHANGES:
// - Reduced sizes: small | normal (removed large)
// - Lighter outline background for better readability
// - Unified hover transitions
// ============================================================================

interface Props {
  href: string;
  variant?: 'primary' | 'outline' | 'ghost';
  size?: 'small' | 'normal';
  icon?: 'arrow-right' | 'external';
  external?: boolean;
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'normal',
  icon,
  external = false,
  class: className = ''
} = Astro.props;

const classes = [
  'link-button',
  `link-button--${variant}`,
  `link-button--${size}`,
  icon && 'link-button--with-icon',
  className
].filter(Boolean).join(' ');

const linkProps = external ? {
  target: '_blank',
  rel: 'noopener noreferrer'
} : {};
---

<a href={href} class={classes} {...linkProps}>
  <span class="link-button__text">
    <slot />
  </span>
  
  {icon === 'arrow-right' && (
    <svg 
      class="link-button__icon" 
      width="16" 
      height="16" 
      viewBox="0 0 24 24" 
      fill="none" 
      stroke="currentColor" 
      stroke-width="2" 
      stroke-linecap="round" 
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M5 12h14M12 5l7 7-7 7"/>
    </svg>
  )}
  
  {icon === 'external' && (
    <svg 
      class="link-button__icon" 
      width="16" 
      height="16" 
      viewBox="0 0 24 24" 
      fill="none" 
      stroke="currentColor" 
      stroke-width="2" 
      stroke-linecap="round" 
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
      <polyline points="15 3 21 3 21 9"/>
      <line x1="10" y1="14" x2="21" y2="3"/>
    </svg>
  )}
</a>

<style>
  /* ========================================================================
     LINK BUTTON - PHASE 2 REFACTOR
     Simplified to 2 sizes, lighter outline variant
     ======================================================================== */
  .link-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    font-family: var(--font-sans);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    border-radius: var(--radius-md);
    border: 1px solid transparent;
    cursor: pointer;
    transition: all var(--transition-base);
    white-space: nowrap;
  }

  /* ========================================================================
     SIZE VARIANTS - Reduced to 2
     ======================================================================== */
  .link-button--small {
    padding: var(--space-xs) var(--space-md);
    font-size: var(--text-sm);
  }

  .link-button--normal {
    padding: var(--space-sm) var(--space-lg);
    font-size: var(--text-base);
  }

  /* ========================================================================
     STYLE VARIANTS
     ======================================================================== */
  
  /* Primary - Solid teal background */
  .link-button--primary {
    background: var(--color-primary);
    color: var(--color-text);
    border-color: var(--color-primary);
  }

  .link-button--primary:hover,
  .link-button--primary:focus-visible {
    background: var(--color-primary-bright);
    border-color: var(--color-primary-bright);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(10, 147, 150, 0.3);
  }

  /* Outline - Light background for better readability */
  .link-button--outline {
    background: rgba(93, 225, 228, 0.08);
    color: var(--color-primary-bright);
    border-color: rgba(93, 225, 228, 0.35);
  }

  .link-button--outline:hover,
  .link-button--outline:focus-visible {
    background: rgba(93, 225, 228, 0.15);
    border-color: var(--color-primary-bright);
    transform: translateY(-1px);
  }

  /* Ghost - Minimal style */
  .link-button--ghost {
    background: transparent;
    color: var(--color-text-muted);
    border-color: transparent;
  }

  .link-button--ghost:hover,
  .link-button--ghost:focus-visible {
    color: var(--color-primary-bright);
    background: rgba(93, 225, 228, 0.08);
  }

  /* ========================================================================
     ICON HANDLING
     ======================================================================== */
  .link-button__icon {
    flex-shrink: 0;
    transition: transform var(--transition-base);
  }

  .link-button--with-icon:hover .link-button__icon {
    transform: translateX(2px);
  }

  /* ========================================================================
     ACCESSIBILITY
     ======================================================================== */
  .link-button:focus-visible {
    outline: 2px solid var(--color-primary-bright);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .link-button,
    .link-button__icon {
      transform: none !important;
      transition: none;
    }
  }

  /* ========================================================================
     MOBILE OPTIMIZATION
     ======================================================================== */
  @media (max-width: 640px) {
    .link-button {
      width: 100%;
    }
  }
</style>