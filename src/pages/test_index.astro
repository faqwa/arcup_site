---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArcCanvas from "../components/ArcCanvas.astro";
import HomeHero from "../components/HomeHero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import SectionDivider from "../components/SectionDivider.astro";
import Card from "../components/Card.astro";
import LinkButton from "../components/LinkButton.astro";
import "../styles/global-v2.css";
import "../styles/home.css";
import { withBase } from "../utils/paths";
import { buildSEO } from "../utils/seo";

const seo = buildSEO({
  title: "ArcUp — Open Research for a Thriving Earth",
  description:
    "ArcUp develops open plasma systems for ecological repair through transparent, collaborative, and ethical research.",
  path: "/draft",
  siteUrl: Astro.site,
});
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  seo={seo}
  bodyClass="page-home"
  navActive="home"
>
  <ArcCanvas slot="before-header" />

  <main id="main-content" class="page-shell" aria-labelledby="main-title">
    <!-- ================================================================ -->
    <!-- SECTION 1: HERO -->
    <!-- ================================================================ -->
    <HomeHero />

    <SectionDivider />

    <!-- ================================================================ -->
    <!-- SECTION 2: FROM ENERGY TO ECOSYSTEMS -->
    <!-- ================================================================ -->
    <section
      class="page-section page-section--center energy-ecosystems"
      aria-labelledby="energy-ecosystems-title"
    >
      <SectionHeader
        eyebrow="Research Across Four Scales"
        title="From Energy to Ecosystems"
        subtitle="ArcUp studies how plasma interacts across four connected scales — from device to droplet, organism to ecosystem. Together, these scales form a continuum of repair."
        align="center"
      />

      <div class="flow-container">
        <div class="ecosystem-top-row" role="list">
          <Card as="article" variant="surface" hover={true} role="listitem">
            <h3>
              <span class="card-icon" aria-hidden="true">⚡</span>
              Technology
            </h3>
            <p>
              We develop plasma systems that convert electrical energy into controlled discharges.
              Research spans community prototypes and institutional platforms, focusing on safety,
              reproducibility, and open-hardware standards.
            </p>
            <ul class="focus-list">
              <li>Dielectric-barrier discharges</li>
              <li>Modular architecture</li>
              <li>Scalable applications</li>
            </ul>
          </Card>

          <Card as="article" variant="surface" hover={true} role="listitem">
            <h3>
              <span class="card-icon" aria-hidden="true">💧</span>
              Water Systems
            </h3>
            <p>
              Water is the first interface between plasma energy and matter.
              We measure how reactive species change water chemistry and oxidation balance,
              linking laboratory data to field applications.
            </p>
            <ul class="focus-list">
              <li>Advanced oxidation and desalination</li>
              <li>Pollutant and pathogen degradation</li>
              <li>Water reuse studies</li>
            </ul>
          </Card>

          <Card as="article" variant="surface" hover={true} role="listitem">
            <h3>
              <span class="card-icon" aria-hidden="true">🌿</span>
              Organisms
            </h3>
            <p>
              We examine how plasma-treated environments influence microbes, plants, and higher
              organisms. Experiments connect molecular change with physiological response to assess
              benefit, risk, and repeatability.
            </p>
            <ul class="focus-list">
              <li>Plant stress adaptation</li>
              <li>Microbiome community shifts</li>
              <li>Heritable and non-genetic responses</li>
            </ul>
          </Card>
        </div>

        <div class="flow-connector">
          <div class="flow-arrow" aria-hidden="true">
            <svg
              width="2"
              height="60"
              viewBox="0 0 2 60"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <line
                x1="1"
                y1="0"
                x2="1"
                y2="50"
                stroke="url(#gradient)"
                stroke-width="2"
              />
              <path
                d="M1 60L0 54L1 56L2 54L1 60Z"
                fill="currentColor"
                class="arrow-tip"
              />
              <defs>
                <linearGradient
                  id="gradient"
                  x1="1"
                  y1="0"
                  x2="1"
                  y2="50"
                  gradientUnits="userSpaceOnUse"
                >
                  <stop offset="0%" stop-color="transparent" />
                  <stop offset="20%" stop-color="rgba(93,225,228,0.3)" />
                  <stop offset="100%" stop-color="rgba(93,225,228,0.6)" />
                </linearGradient>
              </defs>
            </svg>
          </div>

          <div class="connector-text">
            <p class="eyebrow">Systemic Function</p>
            <p class="connector-lead">
              From controlled plasma experiments to ecological restoration — where energy becomes
              ecology.
            </p>
          </div>
        </div>

        <div class="ecosystem-bottom">
          <Card
            as="article"
            variant="surface"
            hover={true}
            class="card--featured"
          >
            <h3>
              <span class="card-icon" aria-hidden="true">🌍</span>
              Ecosystems
            </h3>
            <p>
              We study how plasma processes contribute to ecosystem resilience.
              Field and mesocosm work integrate plasma into soils, wetlands, and regeneration
              systems, connecting local interventions to global repair.
            </p>
            <ul class="focus-list">
              <li>Ecological functionality</li>
              <li>Coupling and cycling dynamics</li>
              <li>Adaptive regeneration modelling</li>
            </ul>
          </Card>
        </div>
      </div>
    </section>

    <SectionDivider />

    <!-- ================================================================ -->
    <!-- SECTION 3: GETTING INVOLVED -->
    <!-- ================================================================ -->
    <section
      class="page-section page-section--center getting-involved"
      aria-labelledby="getting-involved-title"
    >
      <SectionHeader
        eyebrow="Participation"
        title="Getting Involved"
        subtitle="ArcUp is collaborative infrastructure for those building knowledge toward planetary repair. It is early-stage work — open for contribution."
        align="center"
      />

      <div class="participation-grid">
        <Card as="article" variant="surface" hover={true} role="listitem">
          <div class="card-icon" aria-hidden="true">🎓</div>
          <h3>For Students</h3>
          <p>
            You can integrate ArcUp projects into your studies.
            Work with your supervisor to develop a proposal that explores plasma’s ecological
            potential while contributing to shared datasets.
          </p>
          <p class="card-note">
            <em>Requirements: clear proposal, supervisor approval, open-license commitment.</em>
          </p>
        </Card>

        <Card as="article" variant="surface" hover={true} role="listitem">
          <div class="card-icon" aria-hidden="true">🔬</div>
          <h3>For Researchers</h3>
          <p>
            ArcUp invites method validation and co-development.
            Your expertise helps test and refine plasma–water frameworks for ecological
            applications and responsible use.
          </p>
          <p class="card-note">
            <em>Opportunities: method review, replication, and shared data design.</em>
          </p>
        </Card>

        <Card as="article" variant="surface" hover={true} role="listitem">
          <div class="card-icon" aria-hidden="true">🌍</div>
          <h3>For Practitioners & Collectives</h3>
          <p>
            Community labs and independent groups can apply ArcUp technologies under shared safety
            and reporting standards. Results contribute to a common archive for ecological repair.
          </p>
          <p class="card-note">
            <em>Start by reviewing Workspace documentation and connecting with peers.</em>
          </p>
        </Card>
      </div>

      <div class="involvement-cta">
        <LinkButton
          href={withBase("/join")}
          variant="primary"
          icon="arrow-right"
          aria-label="Join the ArcUp community"
        >
          Join the Community
        </LinkButton>

        <LinkButton
          href={withBase("/workspace")}
          variant="outline"
          aria-label="Explore ArcUp workspace and documentation"
        >
          Explore Workspace →
        </LinkButton>
      </div>
    </section>
  </main>
</BaseLayout>
