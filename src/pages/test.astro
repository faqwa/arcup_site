---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Card from "../components/Card.astro";
import SectionDivider from "../components/SectionDivider.astro";
import "../styles/global-v2.css";
import "../styles/animations.css";

const seo = {
  title: "ArcUp Style Guide — Alignment & Rhythm",
  description: "Visual alignment and containment test for ArcUp global layout system.",
};
---

<BaseLayout title={seo.title} description={seo.description} seo={seo}>
  <main id="main-content" class="page-shell">

    <!-- ================================================================ -->
    <!-- 1. TYPOGRAPHIC + BASELINE TEST -->
    <!-- ================================================================ -->
    <section class="page-section section--dense bg-gradient-teal align-left">
      <SectionHeader
        eyebrow="Test 1"
        title="Typographic Rhythm"
        subtitle="This section ensures baseline spacing, line height, and containment behave consistently."
        align="left"
      />
      <div class="content-prose">
        <p>
          ArcUp typography operates on a <strong>1.1rem baseline</strong>.
          Headings, lists, and paragraph spacing should appear even and balanced,
          forming a consistent visual rhythm without overlaps.
        </p>
        <ul>
          <li>Body line-height follows <code>--line-rhythm-normal</code></li>
          <li>Headings use <code>--line-rhythm-tight</code></li>
          <li>Muted text tone equals <code>--color-text-muted</code></li>
        </ul>
        <p class="text-secondary">
          If this paragraph feels too close or too wide compared to others, spacing
          or line-height values may need calibration.
        </p>
      </div>
    </section>

    <SectionDivider variant="strong" />

    <!-- ================================================================ -->
    <!-- 2. ALIGNMENT TEST -->
    <!-- ================================================================ -->
    <section class="page-section bg-surface-soft">
      <SectionHeader
        eyebrow="Test 2"
        title="Alignment Logic"
        subtitle="Left, center, and grid alignments follow contextual purpose: clarity for procedural, calm for reflective."
        align="center"
      />
      <div class="alignment-grid">
        <div class="align-left">
          <h4>Left Aligned</h4>
          <p>Used for instructional or procedural content where rapid scanning is needed.</p>
        </div>
        <div class="align-center">
          <h4>Center Aligned</h4>
          <p>Used for introductions, CTAs, and summaries where balance and calm matter.</p>
        </div>
      </div>
    </section>

    <SectionDivider variant="subtle" />

    <!-- ================================================================ -->
    <!-- 3. CARD CONTAINMENT TEST -->
    <!-- ================================================================ -->
    <section class="page-section section--dense bg-surface-soft">
      <SectionHeader
        eyebrow="Test 3"
        title="Card Containment & Hover"
        subtitle="Cards should maintain internal padding and avoid touching tinted section edges."
        align="center"
      />
      <div class="card-grid card-grid--3">
        <Card variant="surface" hover>
          <div class="card-icon">🧩</div>
          <h3>Default Surface</h3>
          <p>Tests gradient and blur containment at default radius and shadow depth.</p>
        </Card>
        <Card variant="surface" hover>
          <div class="card-icon">⚙️</div>
          <h3>Clickable Card</h3>
          <p>Simulates a linkable surface using hover + arrow animation.</p>
        </Card>
        <Card variant="surface" hover>
          <div class="card-icon">🌿</div>
          <h3>Active Glow</h3>
          <p>Displays the intended tactile feel when focused or hovered.</p>
        </Card>
      </div>
    </section>

    <SectionDivider variant="strong" />

    <!-- ================================================================ -->
    <!-- 4. GRID & CONTAINMENT WIDTHS -->
    <!-- ================================================================ -->
    <section class="page-section bg-gradient-teal">
      <SectionHeader
        eyebrow="Test 4"
        title="Container Widths"
        subtitle="All sections respect shell width and padding. Check edge breathing on all viewports."
        align="center"
      />
      <div class="content-container">
        <p class="content-prose">
          This block sits within <code>.content-container</code>, ensuring content
          never touches the screen edge and remains optically centered. Resize the
          viewport to confirm fluid containment.
        </p>
      </div>
    </section>

    <SectionDivider variant="subtle" />

    <!-- ================================================================ -->
    <!-- 5. FINAL COLOR + MOTION TEST -->
    <!-- ================================================================ -->
    <section class="page-section section--spacious bg-gradient-teal align-center">
      <SectionHeader
        eyebrow="Test 5"
        title="Color, Motion & Closure"
        subtitle="Gradient blends and reveal sequences should remain calm and smooth."
        align="center"
      />
      <div class="card-grid card-grid--2 reveal-group">
        <Card variant="surface" hover class="fade-in-up delay-2">
          <h3>Teal Gradient Consistency</h3>
          <p>Observe transition between surface color and background gradient.</p>
        </Card>
        <Card variant="surface" hover class="fade-in-up delay-3">
          <h3>Motion Synchronization</h3>
          <p>Cards reveal sequentially with <code>.fade-in-up</code> and stagger delay.</p>
        </Card>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .alignment-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-xl);
    margin-top: var(--space-xl);
  }

  .alignment-grid h4 {
    font-size: var(--text-lg);
    color: var(--color-primary-bright);
    margin-bottom: var(--space-sm);
  }
</style>
