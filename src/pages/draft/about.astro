---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArcCanvas from "../../components/ArcCanvas.astro";
import PageNavigation from "../../components/PageNavigation.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import SectionDivider from "../../components/SectionDivider.astro";
import Card from "../../components/Card.astro";
import LinkButton from "../../components/LinkButton.astro";
import "../styles/global-v2.css";

import { withBase } from "../../utils/paths";
import { buildSEO } from "../../utils/seo";

const seo = buildSEO({
  title: "About ArcUp",
  description: "ArcUp is an open experimental research framework developing plasma technologies for ecological repair and resilience.",
  path: "/about",
  siteUrl: Astro.site,
});
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  seo={seo}
  bodyClass="page-about"
  navActive="about"
>
  <ArcCanvas slot="before-header" />

  <main id="main-content" class="page-shell" aria-labelledby="page-title">

    <!-- ================================================================ -->
    <!-- HERO SECTION -->
    <!-- ================================================================ -->
    <header class="page-hero" aria-labelledby="page-title">
      <p class="eyebrow">Repractising Science & Innovation</p>
      <h1 id="page-title">About ArcUp</h1>
      <p class="lead">
        ArcUp is an <strong>open experimental research framework</strong> developing plasma technologies for ecological repair and resilience.
      </p>

      <div class="content-prose">
        <p>
          We align research and innovation through the <a href="https://repractice.xbyali.page" target="_blank" rel="noopener noreferrer">Repractice Ethical Framework</a>, which grounds every project in transparency, reciprocity, and care for living systems.
        </p>
      </div>
    </header>

    <SectionDivider />

    <!-- ================================================================ -->
    <!-- SECTION: Our Focus — Structure and Purpose -->
    <!-- ================================================================ -->
    <section class="page-section page-section--center" aria-labelledby="focus-title">
      <SectionHeader
        title="Our Focus"
        subtitle="How ArcUp connects open research with planetary purpose — building transparent pathways between people, institutions, and local projects."
        align="center"
      />

      <div class="card-grid card-grid--2">
        <Card as="article" variant="surface" hover={true}>
          <h3>Structure: Open by Design</h3>
          <p>
            ArcUp unites ethics, technology, and experimentation to make plasma research accessible to everyone. By sharing methods and results openly, the framework builds transparency, trust, and collaboration between people, communities, and researchers.
          </p>
        </Card>

        <Card as="article" variant="surface" hover={true}>
          <h3>Purpose: Regeneration as Practice</h3>
          <p>
            ArcUp turns research into a shared act of regeneration — open, ethical, and collaborative. Each experiment explores how plasma can support life systems and how open science can model a more regenerative relationship with Earth.
          </p>
        </Card>
      </div>
    </section>

    <SectionDivider />

    <!-- ================================================================ -->
    <!-- SECTION: Navigation to Subpages -->
    <!-- ================================================================ -->
    <section class="page-section page-section--center" aria-labelledby="explore-title">
      <SectionHeader
        title="What You'll Find Here"
        subtitle="Learn the story, people, and purpose behind ArcUp."
        align="center"
      />

      <div class="card-grid card-grid--3">
        <Card as="article" variant="outline" hover={true}>
          <h3>Origin</h3>
          <p>
            How a small plasma–seed experiment became a framework for regenerative research.
          </p>
          <LinkButton 
            href={withBase('/about/origin')} 
            variant="outline" 
            icon="arrow-right"
          >
            Read the Story
          </LinkButton>
        </Card>

        <Card as="article" variant="outline" hover={true}>
          <h3>Founder</h3>
          <p>
            Meet Ali Saleh and the systems thinking shaping ArcUp's interdisciplinary approach.
          </p>
          <LinkButton 
            href={withBase('/about/founder')} 
            variant="outline" 
            icon="arrow-right"
          >
            Meet Ali
          </LinkButton>
        </Card>

        <Card as="article" variant="outline" hover={true}>
          <h3>Mission</h3>
          <p>
            Discover the vision, phases, and long-term goal of a commons for plasma research.
          </p>
          <LinkButton 
            href={withBase('/about/mission')} 
            variant="outline" 
            icon="arrow-right"
          >
            Explore the Mission
          </LinkButton>
        </Card>
      </div>
    </section>

    <SectionDivider />

    <!-- ================================================================ -->
    <!-- SECTION: Call to Action -->
    <!-- ================================================================ -->
    <section class="page-section page-section--center" aria-labelledby="cta-title">
      <SectionHeader
        title="Be Part of the Work"
        subtitle="ArcUp is a living framework — shaped by everyone who contributes."
        align="center"
      />

      <div class="content-prose text-center">
        <p>
          Join the community, share ideas, or see what's currently in development at <a href="https://workspace.xbyali.page" target="_blank" rel="noopener noreferrer">Workspace by Ali</a>.
        </p>
      </div>

      <div class="section-cta">
        <LinkButton 
          href={withBase('/join')} 
          variant="primary" 
          icon="arrow-right"
        >
          Get Involved
        </LinkButton>
      </div>
    </section>

    <SectionDivider />

  </main>

  <PageNavigation currentPage="about" />
</BaseLayout>