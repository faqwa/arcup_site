---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Card from "../components/Card.astro";
import FlowGrid from "../components/FlowGrid.astro";
import LinkButton from "../components/LinkButton.astro";
import "../styles/global-v2.css";
import "../styles/animations.css";
import { withBase } from "../utils/paths";
import { buildSEO } from "../utils/seo";
import SectionDivider from "../components/SectionDivider.astro";

const seo = buildSEO({
  title: "Join — Ways to Take Part in the ArcUp Field",
  description: "ArcUp is open by design. You can engage at the level that fits your time, skills, and curiosity — from observing open research to co-building plasma systems.",
  path: "/join",
  siteUrl: Astro.site,
});
---

<BaseLayout title={seo.title} description={seo.description} seo={seo} navActive="join">
  <main id="main-content" class="page-shell" aria-labelledby="join-title">

    <!-- ================================================================ -->
    <!-- HERO -->
    <!-- ================================================================ -->
    <section class="page-section page-section--center section--spacious bg-gradient-teal">
      <div class="fade-in-up delay-1">
        <SectionHeader
          eyebrow="🜂 Join"
          title="Ways to Take Part in the ArcUp Field"
          subtitle="ArcUp is open by design. You can engage at the level that fits your time, skills, and curiosity — from observing open research to co-building plasma systems."
          align="center"
        />
      </div>

      <div class="section-cta fade-in-up delay-3">
        <LinkButton href={withBase('/workspace')} variant="outline" icon="arrow-right">
          Get Started
        </LinkButton>
        <LinkButton href="#entry-points" variant="primary" icon="arrow-right">
          See Entry Points
        </LinkButton>
      </div>
    </section>

    <!-- ================================================================ -->
    <!-- STEP 1: GET ORIENTED -->
    <!-- ================================================================ -->
    <section class="page-section section--dense bg-surface-soft fade-in-up delay-2" id="oriented">
        <SectionHeader
        eyebrow="1 · Get Oriented"
        title="Learn the Foundation"
        subtitle="Start by understanding how ArcUp and Re:Practise define responsible research."
        align="center"
        />
      <div class="content-prose flow">
        <p><strong>Read:</strong> About ArcUp — the purpose and structure of the framework. Safety & Ethics — the four-lens model of care. Re:Practise Framework — the ethical base for openness and reproducibility.</p>
        <p><strong>Review:</strong> Licensing Guidelines — how open hardware and documentation are shared. Verification Process — what qualifies a result for public release.</p>
        <p>Knowing the principles first prevents re-work later. Ten minutes of reading equals days of saved effort.</p>
      </div>
    </section>

    <!-- ================================================================ -->
    <!-- STEP 2: CLARIFY YOUR WHY -->
    <!-- ================================================================ -->
    <section class="page-section section--dense fade-in-up delay-3" id="why">
     <div class="content-container">
        <SectionHeader
        eyebrow="2 · Clarify Your Why"
        title="Align Intent"
        subtitle="ArcUp began with reflection: what if discovery were shared from the start? What world would this create? Before joining, define your own purpose for working in the open."
      />
      <ul class="focus-list">
        <li>Note the problems or systems you care about.</li>
        <li>Identify the skills you can offer.</li>
        <li>Ask how your contribution supports planetary repair.</li>
      </ul>
      <p class="card-note"><em>You can include these notes when you’re joining the community.</em></p>
    </section>

    <!-- ================================================================ -->
    <!-- STEP 3: FIND ENTRY POINT -->
    <!-- ================================================================ -->
    <section class="page-section bg-surface-soft fade-in-up delay-4" id="entry-points">
      <SectionHeader
        eyebrow="3 · Find Your Entry Point"
        title="Choose How to Contribute"
        subtitle="Each route connects to the same commons of repair — you choose the distance and depth that work for you."
        align="center"
      />
      
       <!-- <Card as="a" href="/workspace" variant="surface" hover>
  <div class="card-icon">🔬</div>
  <h3>Collaborative Projects</h3>
  <p>Join ongoing builds and co-design experiments.</p>
</Card> -->


      <FlowGrid columns={3} connected stagger>
        <Card as="article" variant="surface" hover>
          <h3>Independent Research</h3>
          <p>Use or replicate any open protocol. Attribute, follow safety guidance, and share verified data through Workspace.</p>
          <div class="section-cta">
            <LinkButton href={withBase('/workspace')} variant="ghost" icon="arrow-right">
              Explore Protocols
            </LinkButton>
            <a href={withBase('/workspace')} target="_blank" rel="noopener" class="link-button link-button--primary link-button--icon arrow-right">
              Contributor Form
            </a>
          </div>
        </Card>

        <Card as="article" variant="surface" hover>
          <h3>Collaborative Projects</h3>
          <p>Join ongoing builds and co-design experiments. Publish results collectively and refine shared systems.</p>
          <div class="section-cta">
            <LinkButton href={withBase('/workspace')} variant="outline" icon="arrow-right">
              Open Workspace
            </LinkButton>
            <LinkButton href={withBase('/join-form')} variant="primary" icon="arrow-right">
              Contributor Form
            </LinkButton>
          </div>
        </Card>

        <Card as="article" variant="surface" hover>
          <h3>Framework Application</h3>
          <p>Apply the Re:Practise ethics and safety model to your own field of research or engineering practice.</p>
          <div class="section-cta">
            <LinkButton href={withBase('/repractise')} variant="outline" icon="arrow-right">
              Visit Re:Practise
            </LinkButton>
          </div>
        </Card>

        <Card as="article" variant="surface" hover>
          <h3>Community Network</h3>
          <p>Discuss, troubleshoot, and share progress in real time with peers and mentors across the open field.</p>
          <div class="section-cta">
            <LinkButton href="https://discord.gg/DA8BPA3VsN" external variant="outline" icon="external">
              Join Discord
            </LinkButton>
          </div>
        </Card>

        <Card as="article" variant="surface" hover>
          <h3>Learning Media</h3>
          <p>Watch walkthroughs and open-lab sessions demonstrating current experiments and analysis methods.</p>
          <div class="section-cta">
            <LinkButton href="https://www.youtube.com/@arc-arcup" external variant="outline" icon="external">
              View YouTube
            </LinkButton>
          </div>
        </Card>
      </FlowGrid>
    </section>

    <!-- ================================================================ -->
    <!-- STEP 4: CONNECT -->
    <!-- ================================================================ -->
    <section class="page-section section--dense fade-in-up delay-2" id="connect">
    <div class="content-container">
    <SectionHeader
        eyebrow="4 · Connect"
        title="Join the Active Network"
        subtitle="When you're ready:"
      />
      <ul class="focus-list">
        <li>Submit the Contributor Form to outline your skills and interests.</li>
        <li>Enter the Discord to meet researchers and builders.</li>
        <li>Follow the Workspace for live updates and new experiments.</li>
        <li>Subscribe to YouTube for demonstrations and data reviews.</li>
      </ul>
      <p class="card-note">All collaboration runs under open licensing and transparent authorship. Every verified contribution is credited in the public record.</p>
      <div class="section-cta">
        <LinkButton href={withBase('/join-form')} variant="primary" icon="arrow-right">
          Contributor Form
        </LinkButton>
        <LinkButton href="https://discord.gg/DA8BPA3VsN" external variant="outline" icon="external">
          Join Discord
        </LinkButton>
      </div>
    </section>

    <!-- ================================================================ -->
    <!-- STEP 5: BEGIN -->
    <!-- ================================================================ -->
    <section class="page-section page-section--center section--spacious bg-gradient-teal fade-in-up delay-3" id="begin">
      <SectionHeader
        eyebrow="5 · Begin"
        title="Start Small, Stay Consistent"
        subtitle="Replicate a simple protocol or document an observation. Upload your data and notes through Workspace. Use existing templates for safety checks and formatting."
        align="center"
      />
      <p class="content-prose text-secondary">
        Small, verified contributions accelerate collective learning far more than large unverified ones.
      </p>
      <div class="section-cta">
        <LinkButton href={withBase('/join-form')} variant="primary" icon="arrow-right">
          Submit Contributor Form
        </LinkButton>
        <LinkButton href={withBase('/workspace')} variant="outline" icon="arrow-right">
          Open Workspace
        </LinkButton>
        <LinkButton href="https://discord.gg/DA8BPA3VsN" external variant="outline" icon="external">
          Join Discord
        </LinkButton>
      </div>
    </section>

  </main>
</BaseLayout>
